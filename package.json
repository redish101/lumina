{
  "name": "@redish101/lumina",
  "version": "0.2.0",
  "description": "Lumina · 个人使用的 React 组件库：CSS Modules 设计令牌、Vite 库模式产物、Storybook 文档",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redish101/lumina.git",
    "directory": ""
  },
  "homepage": "https://github.com/redish101/lumina#readme",
  "bugs": {
    "url": "https://github.com/redish101/lumina/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "css-modules",
    "design-system",
    "design-tokens",
    "storybook",
    "vite",
    "typescript",
    "headless"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reset.css": "./dist/styles/reset.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "vite build -c vite.lib.config.ts && node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:use-client": "node scripts/check-use-client.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:use-client",
    "docs:build": "storybook build",
    "docs:preview": "sirv storybook-static --port 6006 --single",
    "clean": "rm -rf dist storybook-static"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sirv-cli": "^3.0.1",
    "storybook": "^10.6.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "author": "redish101"
}
